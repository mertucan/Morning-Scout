# Copy to .env for local runs (never commit .env).
# In GitHub Actions these come from repository secrets instead.

GEMINI_API_KEY=
TAVILY_API_KEY=

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional; defaults to GMAIL_ADDRESS
MAIL_TO=

NTFY_TOPIC=

# Only needed when not using --local / DATA_DIR
GIST_ID=
GIST_TOKEN=

# Optional: folder with config.yaml and state.json for local runs (default: ./data with --local)
# DATA_DIR=./data
